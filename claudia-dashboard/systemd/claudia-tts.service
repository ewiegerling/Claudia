[Unit]
Description=Claudia local Piper speech synthesis
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/claudia-voice/piper-1.4.2
Environment=PYTHONPATH=%h/.local/share/claudia-voice/piper-1.4.2/site-packages
ExecStart=/usr/bin/python3 /opt/claudia-vault/claudia-dashboard/tts-server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
MemoryMax=1G
TasksMax=64
UMask=0077

[Install]
WantedBy=default.target

[Unit]
Description=Claudia local Whisper speech recognition
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/.local/share/claudia-voice/whisper-current/whisper-bin-ubuntu-x64
ExecStart=%h/.local/share/claudia-voice/whisper-current/whisper-bin-ubuntu-x64/whisper-server --host 127.0.0.1 --port 4320 --model %h/.local/share/claudia-voice/models/ggml-base.en.bin --threads 8 --processors 1 --language en --no-timestamps --no-gpu --suppress-nst --prompt "Hey Claudia"
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
MemoryMax=2G
TasksMax=64
UMask=0077

[Install]
WantedBy=default.target

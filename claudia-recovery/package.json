{
  "name": "claudia-recovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent, authenticated break-glass recovery portal for Claudia services.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test --test-concurrency=1 test/server.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/browser.test.mjs",
    "test:cross-browser": "node --test --test-concurrency=1 test/cross-browser.test.mjs",
    "test:a11y": "node --test --test-concurrency=1 test/accessibility.test.mjs",
    "test:production": "node test/production-audit.mjs",
    "test:all": "npm test && npm run test:browser && npm run test:cross-browser && npm run test:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
